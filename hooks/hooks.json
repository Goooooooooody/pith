{
  "description": "pith: keep huge pastes out of context, point Claude at CI run summaries, and summarise giant command output",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pith\" hook prompt",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/pith\" hook post-bash",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
